[Unit]
Description=Lightweight VPS AI service watcher
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/vps-ai
EnvironmentFile=-/etc/vps-ai.env
ExecStart=/usr/bin/python3 /opt/vps-ai/vps_ai.py --watch
Restart=on-failure
RestartSec=10
MemoryMax=128M
CPUQuota=10%
TasksMax=16
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target